{
  "name": "@okou/regex-compose",
  "version": "1.0.1",
  "description": "Template literal for composing RegExp.",
  "type": "module",
  "author": "okou",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
