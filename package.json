    "tsconfig.json"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "lefthook": "1.13.1",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
